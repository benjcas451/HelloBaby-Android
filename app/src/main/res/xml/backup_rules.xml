<?xml version="1.0" encoding="utf-8"?><!--
   Auto-Backup fuer Geraete bis Android 11 (API 30). Dort gibt es nur das
   Cloud-Backup, keinen getrennten Geraete-Transfer - gesichert wird
   deshalb ausschliesslich der Datenbank-Ordner (inklusive der
   WAL-Datei hello_baby.sqlite-wal, sonst kaeme ein veralteter Stand
   zurueck).

   Der media-Ordner bleibt aussen vor (Fotos/Videos sprengen das
   Backup-Kontingent), ebenso hellobaby_settings.xml mit API-Key,
   Cloudflare Service Token und geraetegebundener SAF-URI.
   Siehe data_extraction_rules.xml.
-->
<full-backup-content>
    <include domain="root" path="app_flutter/HelloBaby" />
    <exclude domain="root" path="app_flutter/HelloBaby/media" />
</full-backup-content>
